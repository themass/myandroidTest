<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.openapi.core.favorite.FavoriteImageView
        android:id="@+id/iv_favorite"
        android:layout_width="@dimen/margin_favrite"
        android:layout_height="@dimen/margin_favrite"
        android:layout_alignParentBottom="true"
        android:background="@drawable/btn_default_light"
        android:padding="@dimen/margin_2"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu_favorite_no" />

    <ImageView
        android:id="@+id/iv_open_browser"
        android:layout_width="@dimen/margin_favrite"
        android:layout_height="@dimen/margin_favrite"
        android:layout_above="@id/iv_favorite"
        android:layout_marginBottom="@dimen/margin_2"
        android:background="@drawable/btn_default_light"
        android:clickable="true"
        android:padding="@dimen/margin_2"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu_share" />

    <ImageView
        android:id="@+id/iv_m3u8_lines"
        android:layout_width="@dimen/margin_favrite"
        android:layout_height="@dimen/margin_favrite"
        android:layout_above="@id/iv_open_browser"
        android:layout_marginBottom="@dimen/margin_2"
        android:background="@drawable/btn_default_light"
        android:clickable="true"
        android:contentDescription="@string/favorite_m3u8_line1"
        android:padding="@dimen/margin_2"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_browser1"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_translate"
        android:layout_width="@dimen/margin_favrite"
        android:layout_height="@dimen/margin_favrite"
        android:layout_above="@id/speed"
        android:layout_marginBottom="@dimen/margin_2"
        android:background="@drawable/btn_default_light"
        android:clickable="true"
        android:gravity="center"
        android:text="@string/favorite_translate"
        android:textColor="@color/base_white"
        android:textSize="@dimen/textsize_12"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/speed"
        android:layout_width="@dimen/margin_favrite"
        android:layout_height="@dimen/margin_favrite"
        android:layout_above="@id/iv_m3u8_lines"
        android:layout_marginBottom="@dimen/margin_2"
        android:background="@drawable/btn_default_light"
        android:clickable="true"
        android:gravity="center"
        android:textColor="@color/base_white"
        android:visibility="gone" />

</RelativeLayout>
