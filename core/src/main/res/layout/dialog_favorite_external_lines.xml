<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_favorite_sheet_panel">

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/favorite_external_sheet_title"
        android:textColor="#E8EAED"
        android:textSize="17sp"
        android:textStyle="bold"
        android:paddingBottom="14dp" />

    <TextView
        android:id="@+id/tv_external_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_favorite_sheet_row"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/favorite_m3u8_line1"
        android:textColor="#E8EAED"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/tv_external_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_favorite_sheet_row"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/favorite_m3u8_line2"
        android:textColor="#E8EAED"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_sheet_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_favorite_sheet_row_muted"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/favorite_external_sheet_cancel"
        android:textColor="#9AA0A6"
        android:textSize="15sp" />
</LinearLayout>
