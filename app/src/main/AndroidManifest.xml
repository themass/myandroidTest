        <service
            android:name="org.strongswan.android.logic.VpnStateService"
            android:exported="false" />
        <!--
            WireGuard 官方库自带的 VpnService 组件。保留，不要移除。
            早前这里曾用 tools:node="remove" 把它删掉，理由是"同一个 App 不能有
            两个 VpnService"——这个理由是错的：Android 的限制是运行时同一时刻只能有
            一个 TUN 处于建立（established）状态，不是 manifest 里只能声明一个
            VpnService 组件。GoBackend.setState() 内部用
            startService(new Intent(context, GoBackend$VpnService.class)) 来真正
            建立 TUN（反编译确认），移除这个声明会让 WireGuard 在运行时直接抛
            ComponentNotFoundException，表现为"编译通过但协议完全不能用"。
            真正的互斥已经在 CharonVpnSessionRepository.connect() 里做了：
            切换协议前会先 disconnect() 旧引擎，两个 VpnService 组件不会同时持有 TUN。
        -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE" />
        <service
            android:name="org.strongswan.android.logic.CharonVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <!--android:process="com.timeline.vpn.service.vpnservice">-->
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name="com.openapi.data.vpn.engine.SingBoxVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
