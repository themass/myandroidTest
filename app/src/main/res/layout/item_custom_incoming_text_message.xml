<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/message_padding_bottom"
    android:layout_marginLeft="@dimen/message_padding_left"
    android:layout_marginRight="@dimen/message_padding_right"
    android:layout_marginTop="@dimen/message_padding_top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/messageUserAvatar"
        android:layout_width="@dimen/message_avatar_width"
        android:layout_height="@dimen/message_avatar_height"
        android:layout_marginEnd="@dimen/message_avatar_padding"
        android:layout_marginRight="@dimen/message_avatar_padding" />

    <!--this view is needed for custom holder-->
    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignEnd="@id/messageUserAvatar"
        android:layout_alignRight="@id/messageUserAvatar"
        android:layout_alignTop="@id/messageUserAvatar"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp" />
    <!--        android:layout_toEndOf="@id/messageUserAvatar"-->
    <!--        android:layout_toRightOf="@id/messageUserAvatar"-->
    <LinearLayout
        android:id="@id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:layout_alignStart="@+id/messageUserAvatar"
        android:layout_below="@+id/messageUserAvatar"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:visibility="gone"
            android:id="@id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp"
            android:layout_marginStart="8dp"
            />
        <WebView
            android:id="@+id/markdownMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:layout_marginEnd="4dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="4dp"
            android:layout_marginStart="8dp"
            tools:ignore="WebViewLayout" />
    </LinearLayout>

    <TextView
        android:id="@+id/messageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/bubble"
        android:layout_below="@id/bubble"
        android:layout_marginLeft="10dp" />

</RelativeLayout>