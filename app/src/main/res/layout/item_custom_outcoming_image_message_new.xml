<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/message_padding_bottom"
    android:layout_marginLeft="@dimen/message_padding_left"
    android:layout_marginRight="@dimen/message_padding_right"
    android:layout_marginTop="@dimen/message_padding_top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/messageUserAvatar"
        android:layout_width="@dimen/message_avatar_width"
        android:layout_height="@dimen/message_avatar_height"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="@dimen/message_avatar_padding"
        android:layout_marginTop="@dimen/message_avatar_padding_top"
        android:background="@drawable/ic_default_nan" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/message_bubble_padding"
        android:layout_marginEnd="@dimen/message_bubble_padding"
        android:layout_toLeftOf="@id/messageUserAvatar">

        <LinearLayout
            android:id="@id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/message_bubble_padding_start"
            android:layout_marginLeft="@dimen/message_bubble_padding_start"
            android:orientation="vertical"
            android:gravity="right">
            <ImageView
                android:id="@id/image"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/message_image_size"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/ll_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bubble"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/messageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp" />
        </RelativeLayout>

    </RelativeLayout>


</RelativeLayout>