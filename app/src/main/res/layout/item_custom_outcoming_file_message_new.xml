<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/message_padding_bottom"
    android:layout_marginLeft="@dimen/message_padding_left"
    android:layout_marginRight="@dimen/message_padding_right"
    android:layout_marginTop="@dimen/message_padding_top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/messageUserAvatar"
        android:layout_width="@dimen/message_avatar_width"
        android:layout_height="@dimen/message_avatar_height"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="@dimen/message_avatar_padding"
        android:layout_marginTop="@dimen/message_avatar_padding_top"
        android:background="@drawable/ic_default_nan" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/message_bubble_padding"
        android:layout_marginEnd="@dimen/message_bubble_padding"
        android:layout_toLeftOf="@id/messageUserAvatar">

        <RelativeLayout
            android:id="@id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/message_bubble_padding_start"
            android:layout_marginLeft="@dimen/message_bubble_padding_start"
            android:gravity="center_horizontal">
            <ImageView
                android:id="@id/image"
                android:layout_width="@dimen/margin_30"
                android:layout_height="@dimen/margin_30"
                android:layout_centerVertical="true"
                android:src="@drawable/phone_call"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginRight="@dimen/margin_10"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toRightOf="@id/image">
                <TextView
                    android:id="@+id/file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/margin_200"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/file_minetype"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/textsize_14"
                    />
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rv_ads"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/banner_h"
                android:gravity="center"
                android:visibility="gone"
                />
        </RelativeLayout>

        <com.openapi.ks.myapp.view.MyOutcomingAudioFooterView
            android:id="@+id/ll_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/message_footer_padding_top"
            android:layout_below="@+id/bubble"/>

    </RelativeLayout>


</RelativeLayout>