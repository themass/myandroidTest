<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_list_page">

    <TextView
        android:id="@+id/tv_open_auxio_gpl_module"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:text="@string/music_auxio_gpl_open"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <com.openapi.core.view.view.MyPullView
        android:id="@+id/my_pullview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/music_status"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

    <include
        android:id="@+id/music_status"
        layout="@layout/layout_sound_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <com.openapi.core.view.view.MyFavoriteView
        android:id="@+id/my_favoriteview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/music_status"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/margin_22"
        android:layout_marginBottom="@dimen/margin_10" />

</RelativeLayout>
