<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏：纯色主题底；标题文字做水波纹，下方副标题。
     颜色与 Compose 主题一致（pv_bg / pv_accent / pv_text_*）。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pv_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 标题：文字本身做水波纹（见 RippleTextView） -->
        <com.openapi.ks.ui.main.RippleTextView
            android:id="@+id/launch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/launch_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.3"
            android:text="@string/launch_subtitle"
            android:textColor="@color/pv_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部一行：左下角 logo，右下角 "Look the world" 走马灯（由 LaunchActivity 驱动滚动） -->
    <LinearLayout
        android:id="@+id/launch_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:alpha="0">

        <ImageView
            android:id="@+id/launch_logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/launch_marquee_box"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:clipChildren="true">

            <TextView
                android:id="@+id/launch_marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/launch_look_world"
                android:textColor="@color/pv_text_secondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" />
        </FrameLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_spread"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <RelativeLayout
        android:id="@+id/skip_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:clickable="true">

        <TextView
            android:id="@+id/tv_shu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/launch_skip_bg"
            android:gravity="center"
            android:textColor="@color/pv_text_secondary"
            android:text="@string/skip" />
    </RelativeLayout>
</RelativeLayout>
