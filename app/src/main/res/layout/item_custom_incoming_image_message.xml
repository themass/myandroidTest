<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/message_padding_bottom"
    android:layout_marginLeft="@dimen/message_padding_left"
    android:layout_marginRight="@dimen/message_padding_right"
    android:layout_marginTop="@dimen/message_padding_top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/messageUserAvatar"
        android:layout_width="@dimen/message_avatar_width"
        android:layout_height="@dimen/message_avatar_height"
        android:layout_marginEnd="@dimen/message_avatar_padding"
        android:layout_marginRight="@dimen/message_avatar_padding" />

    <!--this view is needed for custom holder-->
    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignEnd="@id/messageUserAvatar"
        android:layout_alignRight="@id/messageUserAvatar"
        android:layout_alignTop="@id/messageUserAvatar"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp" />

    <com.github.siyamed.shapeimageview.mask.PorterShapeImageView
        android:id="@id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/message_incoming_bubble_margin_right"
        android:layout_marginRight="@dimen/message_incoming_bubble_margin_right"
        android:layout_toEndOf="@id/messageUserAvatar"
        android:layout_toRightOf="@id/messageUserAvatar"
        android:adjustViewBounds="true"
        app:siShape="@drawable/bg_custom_incoming_message"
        app:siSquare="false" />

    <TextView
        android:id="@+id/messageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@id/image"
        android:layout_alignRight="@id/image"
        android:layout_below="@id/image"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp" />

</RelativeLayout>