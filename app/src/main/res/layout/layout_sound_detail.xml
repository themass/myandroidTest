<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_list_page">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/music_detail_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/music_detail_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/sound_detail_back_symbol"
                android:textColor="#ECEFF4"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text="@string/sound_detail_title"
                android:textColor="#ECEFF4"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/music_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/music_status"
            android:layout_below="@+id/music_detail_toolbar"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/music_detail_art"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:contentDescription="@string/sound_detail_art_desc"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_play_filled"
                    tools:ignore="ImageContrastCheck" />

                <com.openapi.core.view.view.MarqueeTextView
                    android:id="@+id/music_detail_track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textColor="#ECEFF4"
                    android:textSize="18sp"
                    tools:text="Track title" />

                <TextView
                    android:id="@+id/music_detail_lyrics_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/music_lyrics_translation_hint"
                    android:textColor="#9AA3B2"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/music_status"
            layout="@layout/layout_sound_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />

        <com.openapi.core.view.view.MyFavoriteView
            android:id="@+id/my_favoriteview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/music_status"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/margin_22"
            android:layout_marginBottom="@dimen/margin_10" />
    </RelativeLayout>
</FrameLayout>
