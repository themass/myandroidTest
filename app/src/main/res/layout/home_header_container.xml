<?xml version="1.0" encoding="utf-8"?>
<!--
  新版首页容器：不使用 CollapsingToolbarLayout，首页内容固定不随滚动移动。
  fl_header 放 VpnRadFragment（地球 + 连接按钮 + 当前节点）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pv_bg">

    <FrameLayout
        android:id="@+id/fl_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:clickable="true"
        android:scaleType="center"
        android:src="@drawable/hand_fb_ad_v2"
        app:backgroundTint="@color/pv_card"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="mini"
        app:rippleColor="@color/pv_selected" />
</FrameLayout>
