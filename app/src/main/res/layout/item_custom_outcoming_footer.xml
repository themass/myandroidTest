<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_sound"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/message_time_padding_top"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/messageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/iv_copy"
        android:layout_width="@dimen/message_footer_image_size"
        android:layout_height="@dimen/message_footer_image_size"
        android:layout_marginRight="@dimen/message_footer_padding_left"
        android:layout_toLeftOf="@+id/messageTime"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/copy" />
    <RelativeLayout
        android:id="@+id/ll_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:gravity="center_vertical"
        android:layout_marginRight="@dimen/message_footer_padding_left"
        android:background="?android:attr/selectableItemBackground"
        android:layout_toLeftOf="@+id/iv_copy"
        android:visibility="gone"
    >
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:textColor="@color/black"
            android:textSize="15sp" />
        <ImageView
            android:id="@+id/ib_audio"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/audio_animation_list_right_3"
            android:layout_toLeftOf="@+id/duration"/>
    </RelativeLayout>
</RelativeLayout>