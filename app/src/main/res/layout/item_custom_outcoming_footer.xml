<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_sound"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/message_time_padding_top">
    <TextView
        android:id="@+id/messageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/iv_copy"
        android:layout_width="@dimen/message_footer_image_size"
        android:layout_height="@dimen/message_footer_image_size"
        android:padding="@dimen/margin_3"
        android:layout_marginEnd="@dimen/message_footer_padding_left"
        android:layout_toStartOf="@+id/messageTime"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_centerVertical="true"
        android:scaleType="fitCenter"
        android:src="@drawable/src_assets_images_copy" />
    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="@dimen/message_footer_image_size"
        android:layout_height="@dimen/message_footer_image_size"
        android:padding="@dimen/margin_5"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/message_footer_padding_left"
        android:layout_toStartOf="@+id/iv_copy"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_del" />
    <RelativeLayout
        android:id="@+id/ll_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:padding="@dimen/message_time_padding_top"
        android:layout_centerVertical="true"
        android:background="?android:attr/selectableItemBackground"
        android:layout_toStartOf="@+id/iv_del"
        android:gravity="center_vertical"
        android:visibility="gone"
    >
        <ImageView
            android:id="@+id/ib_audio"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            android:background="@drawable/audio_animation_list_right_3"
           />
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/ib_audio"/>

    </RelativeLayout>
</RelativeLayout>