<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingLeft="@dimen/padding_10"
    android:paddingRight="@dimen/padding_10"
    android:paddingBottom="@dimen/padding_10">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="15dp"
        android:paddingBottom="15dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/textsize_18"
            android:text="@string/feed_back"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/id_close"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentRight="true"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackground"
            />
    </RelativeLayout>
    <com.donkingliang.labels.LabelsView
        android:id="@+id/labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/message_padding_bottom"
        app:labelBackground="@drawable/chat_feedback_lable"
        app:labelTextColor="@drawable/chat_feedback_lable_text"
        android:layout_marginTop="10dp"
        android:minHeight="25dp"
        android:padding="5dp"
        app:labelTextHeight="wrap_content"
        app:labelTextPaddingBottom="5dp"
        app:labelTextPaddingLeft="10dp"
        app:labelTextPaddingRight="10dp"
        app:labelTextPaddingTop="5dp"
        app:labelTextSize="14sp"
        app:labelTextWidth="wrap_content"
        app:lineMargin="10dp"
        app:maxSelect="0"
        app:minSelect="1"
        app:selectType="SINGLE"
        app:wordMargin="10dp"
        app:isTextBold="true"
        />
    <EditText
        android:id="@+id/edit_text"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="@dimen/message_padding_bottom"
        android:hint="@string/chat_feedback_hint"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:scrollbars="vertical"
        android:maxLines="10"
        android:minLines="1"
        android:background="@color/base_bg"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:padding="8dp" />
    <Button
        android:id="@+id/bt_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/btn_blue"
        android:text="@string/send"
        />
</LinearLayout>
