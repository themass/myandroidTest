<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_centerHorizontal="true"
        android:padding="@dimen/margin_10"
        android:id="@+id/fl_bg">
        <RelativeLayout
            android:id="@+id/vpn_but"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true">
            <ImageButton
                android:id="@+id/iv_vpn_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:background="@drawable/vpn_state_bg"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_vpn_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/vpn_bg_click"
                android:textSize="@dimen/tab_index_vpn_conn"
                android:textStyle="bold" />
        </RelativeLayout>
        <com.king.view.radarview.RadarView
            android:id="@+id/vpn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:visibility="gone"
            />
        <pl.bclogic.pulsator4droid.library.PulsatorLayout
            android:id="@+id/vpn_pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:visibility="gone"
            app:pulse_count="4"
            app:pulse_duration="3000"
            app:pulse_repeat="0"
            app:pulse_color="@color/style_color_primary"
            app:pulse_startFromScratch="false"
            app:pulse_interpolator="Decelerate" />
    </FrameLayout>
    <com.openapi.myapp.ui.globe.GlobeWebView
        android:id="@+id/globe"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_below="@+id/fl_bg"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/card_current_node"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/globe"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/pv_bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_node_label"
                android:textColor="@color/pv_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_current_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_node_none"
                android:textColor="@color/pv_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_current_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pv_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/card_current_node"
        android:orientation="vertical">
    </LinearLayout>
    <TextView
        android:id="@+id/rl_content_em"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/textsize_14"
        android:gravity="center"
        android:background="@color/warning_text"
        android:text="@string/is_emulator"
        android:layout_below="@+id/rl_content"
        android:padding="@dimen/margin_8"
        android:orientation="vertical">
    </TextView>
    <TextView
        android:id="@+id/tv_not_chain"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/textsize_12"
        android:gravity="center"
        android:background="@color/warning_text"
        android:text="@string/support_Chinese"
        android:layout_below="@+id/rl_content_em"
        android:padding="@dimen/margin_8"
        android:orientation="vertical">
    </TextView>
    <LinearLayout
        android:id="@+id/rl_content_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_not_chain"
        android:orientation="vertical">
    </LinearLayout>
    <RelativeLayout
        android:layout_width="@dimen/margin_40"
        android:layout_height="@dimen/margin_40"
        android:id="@+id/rl_gift"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_toLeftOf="@+id/fl_bg"
        android:layout_alignBottom="@+id/fl_bg"
        android:layout_marginBottom="@dimen/margin_22"
        android:src="@drawable/gift"
        >
    </RelativeLayout>
    <ImageButton
        android:layout_width="@dimen/margin_40"
        android:layout_height="@dimen/margin_40"
        android:id="@+id/rl_points"
        android:visibility="gone"
        android:layout_marginRight="@dimen/margin_25"
        android:layout_alignParentRight="true"
        android:layout_alignBottom="@+id/fl_bg"
        android:layout_marginBottom="@dimen/margin_22"
        android:src="@drawable/gift"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackground"

        >
    </ImageButton>
</RelativeLayout>
