<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_sound"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/message_time_padding_top">

    <TextView
        android:id="@+id/messageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/iv_copy"
        android:layout_width="@dimen/message_footer_image_size"
        android:layout_height="@dimen/message_footer_image_size"
        android:layout_marginLeft="@dimen/message_footer_padding_left"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/copy" />

    <ImageView
        android:id="@+id/ib_up"
        android:layout_width="@dimen/message_footer_image_size"
        android:layout_height="@dimen/message_footer_image_size"
        android:layout_marginLeft="@dimen/message_footer_padding_left"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_up" />

    <ImageView
        android:id="@+id/ib_down"
        android:layout_width="@dimen/message_footer_image_size"
        android:layout_height="@dimen/message_footer_image_size"
        android:layout_marginLeft="@dimen/message_footer_padding_left"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_down" />

    <LinearLayout
        android:id="@+id/ll_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/message_footer_padding_left"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/message_time_padding_top"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ib_audio"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/audio_animation_list_left_3" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginRight="4dp"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
