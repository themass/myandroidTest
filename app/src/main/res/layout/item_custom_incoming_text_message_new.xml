<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/message_padding_bottom"
    android:layout_marginLeft="@dimen/message_padding_left"
    android:layout_marginRight="@dimen/message_padding_right"
    android:layout_marginTop="@dimen/message_padding_top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/messageUserAvatar"
        android:layout_width="@dimen/message_avatar_width"
        android:layout_height="@dimen/message_avatar_height"
        android:layout_marginEnd="@dimen/message_avatar_padding"
        android:layout_marginRight="@dimen/message_avatar_padding"
        android:layout_marginTop="@dimen/message_avatar_padding_top"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="@dimen/message_bubble_padding"
        android:layout_marginRight="@dimen/message_bubble_padding"
        android:layout_toRightOf="@id/messageUserAvatar"
        >
        <LinearLayout
            android:id="@id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/markdownMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/textsize_16"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginRight="@dimen/message_bubble_padding_start"
                android:layout_marginLeft="@dimen/message_bubble_padding_start"
                tools:ignore="WebViewLayout" />
            <RelativeLayout
                android:id="@+id/rv_ads"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/banner_h"
                android:gravity="center"
                android:visibility="gone"
                 />
        </LinearLayout>
        <com.openapi.ks.myapp.view.MyIncomingAudioFooterView
            android:id="@+id/ll_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/message_time_padding_top" />

    </LinearLayout>

</RelativeLayout>