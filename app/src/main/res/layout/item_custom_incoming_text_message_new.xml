<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/message_padding_bottom"
    android:layout_marginLeft="@dimen/message_padding_left"
    android:layout_marginRight="@dimen/message_padding_right"
    android:layout_marginTop="@dimen/message_padding_top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/messageUserAvatar"
        android:layout_width="@dimen/message_avatar_width"
        android:layout_height="@dimen/message_avatar_height"
        android:layout_marginEnd="@dimen/message_avatar_padding"
        android:layout_marginRight="@dimen/message_avatar_padding"
        android:layout_marginTop="@dimen/message_avatar_padding_top"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="@dimen/message_bubble_padding"
        android:layout_marginRight="@dimen/message_bubble_padding"
        android:layout_toRightOf="@id/messageUserAvatar"
        >
        <LinearLayout
            android:id="@id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:orientation="vertical">

            <WebView
                android:id="@+id/markdownMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                tools:ignore="WebViewLayout" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="15dp"
            android:clickable="false">

            <ImageButton
                android:id="@+id/ib_audio"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignRight="@+id/messageTime"
                android:background="@drawable/audio_animation_list_left_3"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/messageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>