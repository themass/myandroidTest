<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.skyfishjy.library.RippleBackground
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/style_color_primary_dark"
        app:rb_color="#FFFFFF"
        app:rb_radius="48dp"
        app:rb_rippleAmount="8"
        app:rb_duration="3000"
        app:rb_scale="6">
        
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <com.openai.commonview.view.widget.CircleImageView
                android:id="@+id/centerImage"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ai_chat_1" />

            <ImageView
                android:id="@+id/foundDevice1"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_above="@id/centerImage"
                android:layout_marginRight="9dp"
                android:layout_marginBottom="48dp"
                android:layout_toLeftOf="@id/centerImage"
                android:src="@drawable/ic_heart_small_red"
                android:scaleType="fitCenter"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/foundDevice2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_above="@id/centerImage"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="22dp"
                android:layout_toRightOf="@id/centerImage"
                android:src="@drawable/ic_heart_small_blue"
                android:visibility="gone"
                android:scaleType="fitCenter" />
                
        </RelativeLayout>
    </com.skyfishjy.library.RippleBackground>
</FrameLayout>
