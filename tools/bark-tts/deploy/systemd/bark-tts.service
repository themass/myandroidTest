# Bark TTS PoC —— 原生 systemd 单元（本项目禁止 docker/容器）
#
# 安装（测试机，Ubuntu/Debian 系）：
#   sudo useradd -r -m -d /srv/bark-tts bark-tts
#   sudo -u bark-tts python3.12 -m venv /srv/bark-tts/venv
#   sudo -u bark-tts /srv/bark-tts/venv/bin/pip install -r requirements.txt
#   sudo -u bark-tts git clone https://github.com/suno-ai/bark.git /srv/bark-tts/bark \
#     && sudo -u bark-tts /srv/bark-tts/venv/bin/pip install -e /srv/bark-tts/bark
#   # 权重先落到 /srv/bark-tts/.cache/suno/bark_v0（fetch_weights.py 用 --cache-dir 指过去）
#   sudo cp tools/bark-tts/deploy/systemd/bark-tts.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bark-tts
#
# 前提：这台机器要有 GPU（上游称 small 权重 ~8 GB VRAM）；纯 CPU 只能当开发跑，
# 时延见 README「时延实测」——PoC 在 M5 CPU 上比实时慢，别照搬到线上。

[Unit]
Description=Bark emotional TTS PoC (FastAPI + uvicorn, native process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bark-tts
Group=bark-tts
WorkingDirectory=/srv/bark-tts/app
# server.py 在 tools/bark-tts/app/；部署时把 app/ 拷到 WorkingDirectory，
# bark 包本体是 pip install -e 装进 venv 的，不需要 PYTHONPATH。
ExecStart=/srv/bark-tts/venv/bin/uvicorn app.server:app \
  --host 127.0.0.1 --port 8088 --workers 1
# --workers 1 是硬要求不是调优：bark 模型状态在模块全局 dict（generation.py:36），
# 多 worker = 多份 4.68 GB 权重 + 并发互踩。server.py 内部还有一把 _GEN_LOCK。

Environment=HOME=/srv/bark-tts
Environment=XDG_CACHE_HOME=/srv/bark-tts/.cache
Environment=SUNO_USE_SMALL_MODELS=True
# CUDA 机器上 MPS 设 False；只有 Apple Silicon 才设 True
Environment=SUNO_ENABLE_MPS=False
Environment=SUNO_OFFLOAD_CPU=False
Environment=PYTHONUNBUFFERED=1

Restart=on-failure
RestartSec=5
# 首次请求前 preload 要加载 4.68 GB 权重，别被超时杀了
TimeoutStartSec=600

# 基本加固（PoC 够用；生产还要 nginx 反代 + 鉴权 + 限流，见 README）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
