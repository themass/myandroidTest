<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_list_page">

    <com.openapi.core.legacyui.gsy.ListShellView
        android:id="@+id/my_pullview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/music_status"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

    <include
        android:id="@+id/music_status"
        layout="@layout/layout_sound_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <com.openapi.core.favorite.MyFavoriteView
        android:id="@+id/my_favoriteview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/music_status"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/margin_22"
        android:layout_marginBottom="@dimen/margin_10" />

</RelativeLayout>
