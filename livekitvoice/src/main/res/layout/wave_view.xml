<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:voiceView="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_gravity="center"
            >

            <com.aghajari.waveanimation.AXWaveView
                android:id="@+id/circle_wave"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:shader_color_1="#2BCEFF"
                app:shader_color_2="#0976E3"
                android:layout_gravity="center"
                app:circle="true"
                app:amplitude="-1"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/mic"
                app:tint="@android:color/white"/>

        </FrameLayout>
        <com.aghajari.waveanimation.AXLineWaveView
            android:id="@+id/line_wave"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:shader_color_1="#0976E3"
            app:shader_color_2="#0976E3"
            app:main_wave="false"
            app:max_alpha="120" />
    <com.livekit.voiceassistant.wave.VoiceLineView
        android:id="@+id/voicLine"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        voiceView:fineness="one"
        voiceView:lineSpeed="150" />
    </LinearLayout>