<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:voiceView="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
        <FrameLayout
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:layout_centerInParent="true"
            >

            <com.aghajari.waveanimation.AXWaveView
                android:id="@+id/circle_wave"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:shader_color_1="#2BCEFF"
                app:shader_color_2="#0976E3"
                android:layout_gravity="center"
                app:circle="true"
                app:amplitude="0"
                app:max_alpha="255"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/center_image"
                android:layout_gravity="center"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/mic"
                app:tint="@android:color/white"/>

        </FrameLayout>
    <com.aghajari.waveanimation.AXLineWaveView
        android:id="@+id/line_wave"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:shader_color_1="#2BCEFF"
        app:shader_color_2="#0976E3"
        android:layout_alignParentBottom="true"
        app:main_wave="false"
        app:amplitude="0"
        app:max_alpha="255"/>
    </RelativeLayout>