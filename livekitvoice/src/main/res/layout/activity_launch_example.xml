<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_color">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kimi 风格 UI 启动示例"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- URL 输入 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LiveKit 服务器 URL:"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/white"
        android:hint="wss://testvoice-b8y35yvd.livekit.cloud"
        android:inputType="textUri"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Token 输入 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LiveKit Token:"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/white"
        android:hint="输入您的 LiveKit Token"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:background="@drawable/edit_text_background"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />

    <!-- 启动按钮 -->
    <Button
        android:id="@+id/btn_launch_main_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="方法1: 启动 MainActivity"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#6A4C93"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btn_launch_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="方法2: 启动 Fragment"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#8E44AD"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btn_launch_with_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="方法3: 使用默认参数"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#4A2C5A"
        android:textColor="@android:color/white" />

    <!-- Fragment 容器 -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent" />

    <!-- 说明文本 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="说明：\n• 方法1: 直接启动 MainActivity，最简单\n• 方法2: 在当前 Activity 中显示 Fragment\n• 方法3: 使用预定义的默认参数"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:alpha="0.7"
        android:layout_marginTop="16dp" />

</LinearLayout>
