<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/kimi_padding_md">

    <!-- 视频预览区域 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_video"
        android:layout_width="@dimen/kimi_video_width"
        android:layout_height="@dimen/kimi_video_height"
        android:visibility="gone"
        app:cardBackgroundColor="@color/kimi_video_bg"
        app:cardCornerRadius="@dimen/kimi_video_corner_radius"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 视频占位符 -->
            <LinearLayout
                android:id="@+id/layout_video_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/kimi_video_placeholder"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/kimi_video_placeholder_icon_size"
                    android:layout_height="@dimen/kimi_video_placeholder_icon_size"
                    android:contentDescription="@string/video_placeholder"
                    android:src="@drawable/ic_videocam"
                    android:tint="@color/kimi_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kimi_padding_sm"
                    android:text="@string/video_preview"
                    android:textColor="@color/kimi_text_secondary"
                    android:textSize="@dimen/kimi_text_size_sm" />

            </LinearLayout>

            <!-- 视频控制覆盖层 -->
            <LinearLayout
                android:id="@+id/layout_video_controls_overlay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/kimi_video_controls_height"
                android:layout_gravity="bottom"
                android:background="@drawable/kimi_video_controls_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/kimi_video_overlay_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_active"
                    android:textColor="@color/kimi_video_controls_text"
                    android:textSize="@dimen/kimi_text_size_sm" />

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
