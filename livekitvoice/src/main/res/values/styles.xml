<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kimi 主题样式 -->
    <style name="KimiTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kimi_primary</item>
        <item name="colorSecondary">@color/kimi_secondary</item>
        <item name="colorSurface">@color/kimi_surface</item>
        <item name="colorOnSurface">@color/kimi_text_primary</item>
        <item name="colorOnPrimary">@color/kimi_text_primary</item>
        <item name="colorOnSecondary">@color/kimi_text_primary</item>
        <item name="android:statusBarColor">@color/kimi_bg_top</item>
        <item name="android:navigationBarColor">@color/kimi_bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    
    <!-- 文本样式 -->
    <style name="KimiText.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/kimi_text_size_title</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
    
    <style name="KimiText.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/kimi_text_size_md</item>
        <item name="android:textColor">@color/kimi_text_secondary</item>
        <item name="android:gravity">center</item>
    </style>
    
    <style name="KimiText.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/kimi_text_size_lg</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
    </style>
    
    <style name="KimiText.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/kimi_text_size_sm</item>
        <item name="android:textColor">@color/kimi_text_hint</item>
    </style>
    
    <!-- 按钮样式 -->
    <style name="KimiButton.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/kimi_button_height_lg</item>
        <item name="android:backgroundTint">@color/kimi_button_primary</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
        <item name="android:textSize">@dimen/kimi_text_size_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/kimi_radius_xl</item>
    </style>
    
    <style name="KimiButton.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/kimi_button_height_lg</item>
        <item name="android:backgroundTint">@color/kimi_button_secondary</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
        <item name="android:textSize">@dimen/kimi_text_size_lg</item>
        <item name="cornerRadius">@dimen/kimi_radius_xl</item>
    </style>
    
    <style name="KimiButton.Danger" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/kimi_button_height_lg</item>
        <item name="android:backgroundTint">@color/kimi_button_danger</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
        <item name="android:textSize">@dimen/kimi_text_size_lg</item>
        <item name="cornerRadius">@dimen/kimi_radius_xl</item>
    </style>
    
    <style name="KimiButton.Control" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/kimi_control_button_size</item>
        <item name="android:layout_height">@dimen/kimi_control_button_size</item>
        <item name="android:backgroundTint">@color/kimi_button_primary</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
        <item name="cornerRadius">@dimen/kimi_radius_circle</item>
    </style>
    
    <!-- 卡片样式 -->
    <style name="KimiCard">
        <item name="android:layout_margin">@dimen/kimi_card_margin</item>
        <item name="android:background">@drawable/kimi_card_bg</item>
        <item name="android:elevation">@dimen/kimi_card_elevation</item>
    </style>
    
    <!-- 输入框样式 -->
    <style name="KimiInput">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/kimi_input_margin</item>
        <item name="android:textColor">@color/kimi_text_primary</item>
        <item name="android:textColorHint">@color/kimi_text_hint</item>
        <item name="android:background">@drawable/kimi_card_bg</item>
    </style>
    
    <!-- 控制栏样式 -->
    <style name="KimiControlBar">
        <item name="android:layout_height">@dimen/kimi_control_bar_height</item>
        <item name="android:background">@color/kimi_surface</item>
        <item name="android:elevation">8dp</item>
    </style>
    
    <!-- 状态指示器样式 -->
    <style name="KimiStatusIndicator">
        <item name="android:layout_width">@dimen/kimi_status_indicator_size</item>
        <item name="android:layout_height">@dimen/kimi_status_indicator_size</item>
        <item name="android:background">@drawable/kimi_status_indicator_bg</item>
    </style>
</resources>
