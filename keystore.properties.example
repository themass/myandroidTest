# 复制为 keystore.properties（已在 .gitignore 中忽略）并填入真实值。
#
# 生成新的 release keystore：
#   keytool -genkeypair -v -keystore release.jks -alias <alias> \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# 注意：旧的 keystore 口令曾以明文形式存在于 git 历史中，
# 必须轮换密钥而不是复用。详见 docs/SECURITY.md。
storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=
keyPassword=
