<?xml version="1.0" encoding="utf-8"?>
<!--
  新播放页：裸播放器 + 自绘控件层（Compose）+ 全屏点击区。
  控件层在播放器之上，点击区在两者之间，播放器永远不响应空白点击，避免和 GSY 的手势重叠。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.openapi.feature.video.prototype.BareVideoPlayer
        android:id="@+id/new_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/new_player_click_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/new_player_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
